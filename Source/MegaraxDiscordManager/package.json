{
  "name": "megarax-discord-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Administrador e instalador oficial de Discord para Megarax Network",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "eslint . && prettier --check . && vitest run && tsc -p tsconfig.json",
    "commands:register": "tsx src/cli/register-commands.ts",
    "preview": "tsx src/cli/preview.ts",
    "apply": "tsx src/cli/apply.ts",
    "backup": "tsx src/cli/backup.ts",
    "permissions": "tsx src/cli/permissions-check.ts",
    "content:publish": "tsx src/cli/publish.ts"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "dotenv": "17.2.3",
    "pino": "10.3.1",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "24.10.1",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.7.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.1",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.9.0"
}

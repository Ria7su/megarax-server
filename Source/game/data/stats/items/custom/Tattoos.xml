<item id="9545" type="Armor" name="Tattoo of Fight - Gm Power">
  <for>
    <mul order="0x30" stat="pAtkSpd" val="1.50"/> <!-- Attack Speed +50% -->
    <mul order="0x30" stat="pAtk" val="1.25"/> <!-- P. Atk +20% -->
    <add order="0x40" stat="maxMp" val="1000"/> <!-- Maximum MP +1000 -->
    <add val='50' order='0x40' stat='runSpd'/>
    <mul order="0x30" stat="pDef" val="1.10"/> <!-- P Def. +10% -->
    <mul order="0x30" stat="mDef" val="1.10"/> <!-- M Def. +10% -->
    <add order="0x40" stat="maxHp" val="7000"/> <!-- Maximum HP +1000 -->
  <enchant val='0' order='0x0C' stat='pDef'/>
</for>
</item>

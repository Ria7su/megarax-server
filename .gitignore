# --- Geodata / pathnode (estatico, binario, ~2.3 GB, derivado del cliente) ---
interlude/
Source/game/data/geodata/
Source/login/data/geodata/

# --- Logs / crash dumps / PIDs ---
*.log
Source/game/log/
Source/login/log/
Source/**/hs_err_pid*.log

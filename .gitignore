Source/runtime/supervisor/

# --- Backups ad-hoc (se respaldan aparte) ---
Source/backup/
Source/backups/
*.bak
*.bak_*
Source/libs/*.jar.bak*
Source/libs/*.patched-*.jar

# --- Working dirs de agentes / temporales ---
Source/.codex_tmp_*/
Source/.codex_build_*/
Source/.agents/

# --- Bundles generados ---
Source/game/data/scripts.zip
Source/game/data/scripts/**/*.class

# --- Proyectos satelite (repos / builds propios; se versionan aparte) ---
